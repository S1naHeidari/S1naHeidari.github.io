---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/portrait.jpg';

const title = 'Sina Heidari — PhD Student, Virginia Tech';
const description =
  'Sina Heidari is a PhD student in Computer Science at Virginia Tech working on GPU kernel optimization and LLM agents for high-performance systems.';

const links = [
  { label: 'Email', href: 'mailto:sinaheidari@vt.edu', icon: 'M1.5 6.5A2 2 0 0 1 3.5 4.5h17a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-17a2 2 0 0 1-2-2v-9Zm2-.5a.5.5 0 0 0-.5.5v.3l8 4.9 8-4.9V6.5a.5.5 0 0 0-.5-.5h-15Zm15.5 3.9-7 4.3a1 1 0 0 1-1 0l-7-4.3v5.6a.5.5 0 0 0 .5.5h15a.5.5 0 0 0 .5-.5V9.9Z' },
  { label: 'GitHub', href: 'https://github.com/s1naheidari', icon: 'M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.35.77 1.05.77 2.12v3.15c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=-NFnSYgAAAAJ&hl=en&oi=ao', icon: 'M5.24 5.5h13.52v2.3H5.24V5.5Zm3.5 4.1h9.5c0 2.05-1.1 3.13-3.13 3.13h-1.2v6.02c0 .72-.4 1.1-1.14 1.1h-1.7c-.8 0-1.2-.42-1.14-1.25l.02-.35h.94c.43 0 .64-.19.64-.6v-4.92h-.42c-2.02 0-3.07-1.08-3.07-3.13Zm-.5 2.4 1.7.6-3.68 5.5c-.24.35-.63.4-.98.16l-1.44-.98c-.37-.26-.44-.62-.2-1l4.6-4.28Z' },
  { label: 'CV', href: '/cv.pdf', icon: 'M6 2h9l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Zm8 1.5V8h4.5L14 3.5ZM8 12h8v1.5H8V12Zm0 3.5h8V17H8v-1.5Z' },
];

const projects = [
  {
    name: 'Agentic Kernel Optimization',
    status: 'arXiv 2026',
    statusHref: 'https://arxiv.org/abs/2604.26666',
    description:
      'LLM agents that discover, realize, and compose high-performance GPU kernels — 2× over PyTorch eager on an LLM inference workload.',
    tags: ['LLM agents', 'CUTLASS', 'Kernel synthesis'],
  },
  {
    name: 'Certified Kernel Optimization',
    status: 'In preparation',
    description:
      'Building on what LLMs have achieved in formal proof and reasoning to make GPU kernel optimizations verifiable, not just fast.',
    tags: ['Formal methods', 'Compilers', 'GPU kernels'],
  },
  {
    name: 'Persistent Kernels for Sequence Models',
    status: 'In preparation',
    description:
      'High-performance GPU kernels for the linear-recurrence layers behind modern sequence models.',
    tags: ['GPU kernels', 'ML systems'],
  },
];

const publications = [
  {
    title: 'FACT: Compositional Kernel Synthesis with a Three-Stage Agentic Workflow',
    authors: 'Sina Heidari, Dimitrios S. Nikolopoulos',
    venue: 'arXiv:2604.26666, 2026',
    href: 'https://arxiv.org/abs/2604.26666',
  },
  {
    title: 'Heterogeneity-aware Load Balancing in Serverless Computing Environments',
    authors: 'Sina Heidari, Sadoon Azizi',
    venue: 'Int’l Conference on Internet of Things and Its Applications, 2023',
    href: 'https://ieeexplore.ieee.org/document/10365354',
  },
];
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-b from-stone-50 via-white to-stone-100 text-stone-800">
    <!-- Hero -->
    <header class="mx-auto flex max-w-5xl flex-col items-center px-6 pt-16 pb-20 text-center sm:pt-24">
      <Image
        src={portrait}
        alt="Portrait of Sina Heidari"
        width={520}
        height={780}
        class="w-56 rounded-3xl object-cover object-top ring-4 ring-white shadow-xl shadow-stone-900/10 sm:w-64"
        loading="eager"
      />
      <h1 class="mt-8 text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl">Sina Heidari</h1>
      <p class="mt-3 text-lg text-stone-600">
        PhD student in Computer Science, Virginia Tech
      </p>
      <p class="mt-4 max-w-xl text-stone-600">
        I work on making GPU kernels faster and easier to build — with high-performance
        techniques, LLM agents, and formal tools.
      </p>
      <nav class="mt-8 flex items-center gap-3">
        {links.map((l) => (
          <a
            href={l.href}
            title={l.label}
            aria-label={l.label}
            class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-stone-500 shadow-sm ring-1 ring-stone-200 transition hover:-translate-y-0.5 hover:text-accent hover:shadow-md"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path d={l.icon} />
            </svg>
          </a>
        ))}
      </nav>
    </header>

    <!-- Research -->
    <main class="mx-auto max-w-5xl px-6">
      <section id="research" class="pb-20">
        <h2 class="text-sm font-semibold tracking-widest text-accent uppercase">Research</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => (
            <article class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200/80 transition hover:shadow-md">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-semibold text-stone-900">{p.name}</h3>
                {p.statusHref ? (
                  <a href={p.statusHref} class="shrink-0 rounded-full bg-accent/10 px-2.5 py-1 text-xs font-medium text-accent hover:bg-accent/20">{p.status}</a>
                ) : (
                  <span class="shrink-0 rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-500">{p.status}</span>
                )}
              </div>
              <p class="mt-3 flex-1 text-sm leading-6 text-stone-600">{p.description}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.tags.map((t) => (
                  <span class="rounded-md bg-stone-100 px-2 py-0.5 text-xs text-stone-500">{t}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Publications -->
      <section id="publications" class="pb-20">
        <h2 class="text-sm font-semibold tracking-widest text-accent uppercase">Publications</h2>
        <ol class="mt-6 space-y-5">
          {publications.map((pub, i) => (
            <li class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200/80">
              <p class="font-semibold text-stone-900">
                <span class="mr-2 text-accent" aria-hidden="true">[{i + 1}]</span>
                {pub.href ? <a href={pub.href} class="hover:text-accent hover:underline">{pub.title}</a> : pub.title}
              </p>
              <p class="mt-1 text-sm text-stone-600">{pub.authors}</p>
              <p class="mt-0.5 text-sm text-stone-500 italic">{pub.venue}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- CV -->
      <section id="cv" class="pb-24 text-center">
        <a
          href="/cv.pdf"
          class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 font-medium text-white shadow-md shadow-accent/20 transition hover:-translate-y-0.5 hover:shadow-lg"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M12 3a1 1 0 0 1 1 1v10.6l3.3-3.3a1 1 0 0 1 1.4 1.4l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.4l3.3 3.3V4a1 1 0 0 1 1-1Zm-7 15a1 1 0 0 1 1-1h12a1 1 0 1 1 0 2H6a1 1 0 0 1-1-1Z" />
          </svg>
          Download CV
        </a>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200/70 py-8">
      <div class="mx-auto max-w-5xl px-6 text-sm text-stone-500 flex flex-col sm:flex-row items-center justify-between gap-3">
        <span>Sina Heidari · Blacksburg, VA</span>
        <a href="mailto:sinaheidari@vt.edu" class="hover:text-accent">sinaheidari@vt.edu</a>
      </div>
    </footer>
  </div>
</Layout>
